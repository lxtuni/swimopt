{
  // ==========================================================================
  //  swimopt configuration -- everything tunable lives here.
  //  This file allows // comments; load_cfg strips them before parsing.
  // ==========================================================================

  // --------------------------------------------------------------------------
  //  1. Which model. Swapping robots means changing this one line.
  // --------------------------------------------------------------------------
  "model": "robots/toy_quad.xml",     // active model: toy_quad.xml
  // "model": "robots/body2.xml",     // the BODY2 model produced by import_model.py

  // --------------------------------------------------------------------------
  //  2. Simulation. These two decide how fast a run goes.
  // --------------------------------------------------------------------------
  "timestep":     0.002,   // physics step, s. 0.002 is stable, 0.004 twice as fast
                           // (keep it at or below 0.002 for closed-loop models)
  "sim_time":     8.0,     // simulated seconds per evaluation. Shorter is faster,
                           // but too short and steady-state speed is mismeasured
  "settle_time":  1.0,     // seconds of settling before scoring starts, not counted
  "trunk_body":   "trunk",  // trunk body (auto-detected)
  "vmax_guard":   5.0,     // divergence guard: above this speed the run is aborted
                           // and given the worst possible score

  // --------------------------------------------------------------------------
  //  3. Objective. This is what "swimming well" means.
  //     fitness = forward speed - w_yaw * yaw rate - w_energy * mean power
  // --------------------------------------------------------------------------
  "w_yaw":    0.3,   // yaw penalty. 0 = speed only, circling allowed;
                     // 0.3 = stay roughly straight; 1.0 = strict
  "w_energy": 0.0,   // power penalty. 0 = speed only;
                     // 0.01-0.1 when optimizing cost of transport

  // --------------------------------------------------------------------------
  //  4. Search budget.
  // --------------------------------------------------------------------------
  "budget":  250,      // total rollouts (the second command-line argument wins)
  "popsize": 10,       // CMA-ES candidates per generation; raise to 12-16 in high dims
  "sigma0":  0.25,     // initial search radius in the normalized [0,1] space.
                       // 0.2-0.4 is usual: too large wanders, too small gets stuck
  "seed":    1,        // random seed. A different number is an independent search,
                       // which is how you check that a result is reproducible
  "outdir":  "results",

  // --------------------------------------------------------------------------
  //  5. Hydrodynamics. Put calibrated coefficients here once measured.
  //     Per link: F = buoyancy rho*g*V*f
  //                 + drag 0.5*rho*Cd*A*v|v|*f
  //                 + viscous cv*v*f
  //     f  = immersion fraction, computed from the geometry
  //     Ca = added-mass coefficient
  // --------------------------------------------------------------------------
  "hydro": {
    "rho":     1000.0,   // water density, kg/m^3
    "water_z": 0.0,      // water surface height in world z; put the robot near it
    "exclude": ["vis_"], // geoms whose name contains these are decorative, no forces

    // Used when a geom matches none of the rules below.
    "default": { "cd": [0.3, 0.3, 0.3], "ca": 0.2, "cv": 0.02 },

    // Rules are matched against geom names in order; the first hit wins.
    //   cd = drag coefficient on each local axis. A large normal-to-the-face value
    //        and a small edge-on value are what produce thrust.
    //   ca = added-mass coefficient (flat plate ~1.0, thin rod ~0.3, hull ~0.2)
    //   cv = linear viscous coefficient, which damps low-speed motion
    "rules": [
      { "match": "flip",  "cd": [2.2, 0.10, 0.10], "ca": 1.0, "cv": 0.05 },  // flipper
      { "match": "link",  "cd": [0.5, 0.50, 0.25], "ca": 0.3, "cv": 0.02 },  // leg link
      { "match": "trunk", "cd": [0.9, 1.60, 1.80], "ca": 0.2, "cv": 0.10 }   // hull
      // For the BODY2 model, match on link numbers instead:
      // { "match": "2.4",  "cd": [2.2, 0.10, 0.10], "ca": 1.0, "cv": 0.05 },  // flipper
      // { "match": "2.",   "cd": [0.5, 0.50, 0.25], "ca": 0.3, "cv": 0.02 },  // lower links
      // { "match": "1.",   "cd": [0.5, 0.50, 0.25], "ca": 0.3, "cv": 0.02 },  // upper links
      // { "match": "base", "cd": [0.9, 1.60, 1.80], "ca": 0.2, "cv": 0.10 }   // hull
    ]
  },

  // --------------------------------------------------------------------------
  //  6. Gait parameterization. This sets the size of the search space.
  //     Per actuator: angle = offset + sum_h amp_h * sin(2 pi h f t + phase_h)
  //     dimension = 1 (freq) + 1 (duty)
  //               + H * (amplitude groups + actuators) + offset groups
  // --------------------------------------------------------------------------
  "gait": {
    "harmonics":    2,           // 2 is required for feathering, and for any net
                                 // thrust at all; 1 is only viable with passive flippers
    "duty_range":   [0.25, 0.75],// power-stroke duty range. The paddling literature
                                 // compares 25 / 33 / 50 %
    "freq_range":   [0.2, 2.5],  // stroke frequency range, Hz. Keep it within what the
                                 // real servos can follow
    "amp_range":    [0.0, 0.9],  // joint swing amplitude range, rad
    "offset_range": [-0.5, 0.5], // joint centre angle range, rad. This is the posture
                                 // the legs swing around
    "amp2_scale":   1.0,         // scales the second-harmonic amplitude limit;
                                 // set 0.5 to keep the second harmonic small
    "ramp_t":       1.5,         // ramp-in time, s, so the robot does not lurch at t=0

    // Grouping: actuators whose name contains `match` share amp/offset, which lowers
    // the dimension. Phase is always independent per actuator.
    "groups": [
      { "match": "1.1", "share": ["amp", "offset"] },   // upper joint of every leg
      { "match": "2.1", "share": ["amp", "offset"] },   // lower joint of every leg
      { "match": "3.1", "share": ["amp", "offset"] }    // flipper of every leg
    ]
  }
}
